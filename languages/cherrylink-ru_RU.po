#: js/cherry-app.js:3
#, js-format
msgid "%s post mapped so far"
msgid_plural "%s posts mapped so far"
msgstr[0] "Обработана %s запись"
msgstr[1] "Обработано %s записи"
msgstr[2] "Обработано %s записей"

#: js/cherry-app.js:3
msgid "The server is busy; retrying shortly."
msgstr "Сервер занят, скоро повторим попытку."

#: js/cherry-app.js:3
msgid "Analyze your site"
msgstr "Анализ сайта"

#: js/cherry-app.js:3
msgid "Connected · Free"
msgstr "Подключено · Бесплатный"

#: js/cherry-app.js:3
msgid "Connected"
msgstr "Подключено"

#: js/cherry-app.js:3
msgid "The analysis stopped with an error."
msgstr "Анализ остановлен из-за ошибки."

#: js/cherry-app.js:3
msgid "CherryLink reads your posts once to learn what each one is about, and maps every internal link to find orphan pages and broken links. After that it keeps up automatically whenever you save."
msgstr "CherryLink один раз читает ваши записи, чтобы понять, о чём каждая из них, и строит карту всех внутренних ссылок, чтобы найти страницы-сироты и битые ссылки. Дальше всё обновляется автоматически при сохранении."

#: js/cherry-app.js:3
msgid "Content to analyze"
msgstr "Что анализировать"

