msgstr[1] "Найдено %s записи."
msgstr[2] "Найдено %s записей."

#. translators: 1: free plan learned-post limit, 2: total posts found. "Learned" = analyzed for suggestions; "checked" = links read for link health.
#: js/cherry-app.js:5
#, js-format
msgid "The free plan gives suggestions from your %1$s most recently updated posts (learned). Link health covers all %2$s: it only reads the links already in your posts, so no learning is needed."
msgstr "Бесплатный тариф даёт подсказки по %1$s последним обновлённым записям (изучаются). Здоровье ссылок охватывает все %2$s: оно только читает ссылки, уже имеющиеся в записях, поэтому изучение не требуется."

#. translators: %s: number of posts found
#: js/cherry-app.js:6
#, js-format
msgid "%s post found. All of them will be learned for suggestions and checked for link health."
msgid_plural "%s posts found. All of them will be learned for suggestions and checked for link health."
msgstr[0] "Найдена %s запись. Она будет изучена для подсказок и проверена на здоровье ссылок."
msgstr[1] "Найдено %s записи. Все они будут изучены для подсказок и проверены на здоровье ссылок."
msgstr[2] "Найдено %s записей. Все они будут изучены для подсказок и проверены на здоровье ссылок."

#: js/cherry-app.js:6
msgid "Skip, I'll do it later"
msgstr "Пропустить, сделаю позже"

#: js/cherry-app.js:6
msgid "Skipping goes straight to the dashboard. You can start the analysis there or from CherryLink › Index."
msgstr "Пропуск ведёт сразу на обзор. Запустить анализ можно там или в разделе CherryLink › Индекс."

#: js/cherry-app.js:6
msgid "Analysis started. It runs in the background on your server's scheduler, so you don't have to wait here."
msgstr "Анализ запущен. Он работает в фоне через планировщик вашего сервера, ждать здесь не нужно."

#: js/cherry-app.js:6
#: js/cherry-app.js:7
msgid "See results"
msgstr "Смотреть результаты"

#: js/cherry-app.js:6
msgid "Continue to dashboard"
msgstr "Перейти к обзору"

#: js/cherry-app.js:6
#: js/cherry-app.js:26
msgid "Stop"
msgstr "Остановить"

#: js/cherry-app.js:6
msgid "\"See results\" unlocks when the analysis finishes. If you leave, the dashboard shows the progress."
msgstr "Кнопка «Смотреть результаты» станет доступна после завершения анализа. Если вы уйдёте, ход выполнения виден на обзоре."

#: js/cherry-app.js:6
