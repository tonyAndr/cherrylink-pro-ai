<?xml version="1.0"?>
<ruleset name="CherryLink">
    <description>PSR-12 for our src/, plus WordPress security sniffs and a PHP 7.4 floor.</description>

    <!-- Only our new namespaced code is held to this standard. The legacy procedural
         files are migrated slice by slice; once a slice lands in src/ it is linted here. -->
    <file>src</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/><!-- show sniff codes + progress -->

    <!-- Make PHPCS a hard CI gate on ERRORS only: any error fails the build, while
         the pre-existing advisory warnings (mostly long minified-CSS constant lines
         in Support/Tailwind.php) stay visible without breaking it. Without this,
         phpcs exits non-zero on warnings alone and the gate can never be green. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- Modern OOP style for our own code. We keep PSR-12 structure (bracing,
         spacing, imports, visibility, StudlyCase classes, short arrays) but allow
         snake_case method names: this is a WordPress plugin whose methods mirror
         WP's own snake_case conventions and are called from legacy snake_case sites.
         Forcing camelCase would mean renaming every method + caller mid-refactor. -->
    <rule ref="PSR12">
        <exclude name="PSR1.Methods.CamelCapsMethodName"/>
        <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>
    </rule>

    <!-- WordPress security sniffs (the parts we care about), enforced across src/.
         Every plugin AJAX handler gates on \CherryLink\Ajax\Security::verify() (which
         runs check_ajax_referer() + a capability check); the sniff can't see through
         that static-method indirection, so the verified handlers carry a targeted
         phpcs:ignore on their superglobal reads. -->
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>

    <!-- i18n correctness for src/: require the literal 'cherrylink' text domain and
         flag missing domains, non-literal strings, and malformed translator comments. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="cherrylink"/>
            </property>
        </properties>
    </rule>

    <!-- Enforce the PHP 7.4 floor: fail on any 8.0+ only construct. -->
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
