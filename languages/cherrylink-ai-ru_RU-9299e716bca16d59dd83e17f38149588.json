["\u042d\u0442\u043e\u0442 \u0431\u043b\u043e\u043a \u043d\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0432\u0441\u0442\u0430\u0432\u043a\u0443 \u0441\u0441\u044b\u043b\u043e\u043a"],"No connection to the server":["\u041d\u0435\u0442 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f \u0441 \u0441\u0435\u0440\u0432\u0435\u0440\u043e\u043c"],"Could not load data. Try again.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u0430\u043d\u043d\u044b\u0435. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437."],"Link inserted":["\u0421\u0441\u044b\u043b\u043a\u0430 \u0432\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430"],"LINK_TEXT":["\u0422\u0415\u041a\u0421\u0422_\u0421\u0421\u042b\u041b\u041a\u0418"],"Close":["\u0417\u0430\u043a\u0440\u044b\u0442\u044c"],"CherryLink is not connected yet. Connect the plugin to get link suggestions.":["CherryLink \u0435\u0449\u0451 \u043d\u0435 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0451\u043d. \u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u043f\u043b\u0430\u0433\u0438\u043d, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438 \u0441\u0441\u044b\u043b\u043e\u043a."],"Suggestions":["\u041f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438"],"All posts":["\u0412\u0441\u0435 \u0441\u0442\u0430\u0442\u044c\u0438"],"What to show":["\u0427\u0442\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c"],"Posts":["\u0421\u0442\u0430\u0442\u044c\u0438"],"Link added to \u201c%s\u201d":["\u0421\u0441\u044b\u043b\u043a\u0430 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0430 \u0432 \u00ab%s\u00bb"],"Link removed":["\u0421\u0441\u044b\u043b\u043a\u0430 \u0443\u0431\u0440\u0430\u043d\u0430"],"The post has changed since, so this cannot be undone automatically":["\u0421\u0442\u0430\u0442\u044c\u044f \u0443\u0436\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430\u0441\u044c, \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435\u043b\u044c\u0437\u044f"],"Suggestions for the current text":["\u041f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438 \u043f\u043e \u0442\u0435\u043a\u0443\u0449\u0435\u043c\u0443 \u0442\u0435\u043a\u0441\u0442\u0443"],"Suggestions refreshed for the current text":["\u041f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438 \u043f\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043d\u044b \u043f\u043e \u0442\u0435\u043a\u0443\u0449\u0435\u043c\u0443 \u0442\u0435\u043a\u0441\u0442\u0443"],"Refresh":["\u041e\u0431\u043d\u043e\u0432\u0438\u0442\u044c"],"Your site data was removed after 180 days of inactivity. Analyze the site to get suggestions back.":["\u0414\u0430\u043d\u043d\u044b\u0435 \u0432\u0430\u0448\u0435\u0433\u043e \u0441\u0430\u0439\u0442\u0430 \u0443\u0434\u0430\u043b\u0435\u043d\u044b \u043f\u043e\u0441\u043b\u0435 180 \u0434\u043d\u0435\u0439 \u043d\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438. \u041f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0439\u0442\u0435 \u0441\u0430\u0439\u0442, \u0447\u0442\u043e\u0431\u044b \u0432\u0435\u0440\u043d\u0443\u0442\u044c \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438."],"Key page":["\u041a\u043b\u044e\u0447\u0435\u0432\u0430\u044f \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430"],"Key page \u00b7 %d related post doesn't link here":["\u041a\u043b\u044e\u0447\u0435\u0432\u0430\u044f \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u00b7 %d \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u0430\u044f \u0437\u0430\u043f\u0438\u0441\u044c \u043d\u0435 \u0441\u0441\u044b\u043b\u0430\u0435\u0442\u0441\u044f \u0441\u044e\u0434\u0430","\u041a\u043b\u044e\u0447\u0435\u0432\u0430\u044f \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u00b7 %d \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0437\u0430\u043f\u0438\u0441\u0438 \u043d\u0435 \u0441\u0441\u044b\u043b\u0430\u044e\u0442\u0441\u044f \u0441\u044e\u0434\u0430","\u041a\u043b\u044e\u0447\u0435\u0432\u0430\u044f \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u00b7 %d \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u043d\u0435 \u0441\u0441\u044b\u043b\u0430\u044e\u0442\u0441\u044f \u0441\u044e\u0434\u0430"],"Doesn't link to key page \u201c%s\u201d yet":["\u0415\u0449\u0451 \u043d\u0435 \u0441\u0441\u044b\u043b\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u043a\u043b\u044e\u0447\u0435\u0432\u0443\u044e \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u00ab%s\u00bb"],"Key pages are the hub articles of a topic. CherryLink finds them automatically; you can mark or unmark a page yourself.":["\u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u2014 \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0441\u0442\u0430\u0442\u044c\u0438 \u0442\u0435\u043c\u044b. CherryLink \u043d\u0430\u0445\u043e\u0434\u0438\u0442 \u0438\u0445 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438; \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u0430\u043c\u0438 \u043e\u0442\u043c\u0435\u0442\u0438\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u0438\u043b\u0438 \u0441\u043d\u044f\u0442\u044c \u043e\u0442\u043c\u0435\u0442\u043a\u0443."],"Unmark key page":["\u0421\u043d\u044f\u0442\u044c \u043e\u0442\u043c\u0435\u0442\u043a\u0443 \u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0439"],"Mark as key page":["\u041e\u0442\u043c\u0435\u0442\u0438\u0442\u044c \u043a\u0430\u043a \u043a\u043b\u044e\u0447\u0435\u0432\u0443\u044e"],"Marked as a key page":["\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043e\u0442\u043c\u0435\u0447\u0435\u043d\u0430 \u043a\u0430\u043a \u043a\u043b\u044e\u0447\u0435\u0432\u0430\u044f"],"Key page choice saved":["\u0412\u044b\u0431\u043e\u0440 \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d"],"word found in the text":["\u0441\u043b\u043e\u0432\u043e \u0435\u0441\u0442\u044c \u0432 \u0442\u0435\u043a\u0441\u0442\u0435"]}}}