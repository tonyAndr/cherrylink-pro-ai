{"translation-revision-date":"2026-11-12 12:00+0000","generator":"WP-CLI\/2.7.1","source":"js\/cherry-classic.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ru_RU","plural-forms":"nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);"},"Hide":["\u0421\u043a\u0440\u044b\u0442\u044c"],"Analyze site":["\u041f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u0430\u0439\u0442"],"Connect CherryLink":["\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u044c CherryLink"],"Upgrade":["\u0420\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u044c"],"Edit":["\u0420\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c"],"Categories":["\u0420\u0443\u0431\u0440\u0438\u043a\u0438"],"No incoming links \u00b7 %d post could link here":["\u041d\u0435\u0442 \u0432\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u00b7 %d \u0441\u0442\u0430\u0442\u044c\u044f \u043c\u043e\u0436\u0435\u0442 \u0441\u043e\u0441\u043b\u0430\u0442\u044c\u0441\u044f","\u041d\u0435\u0442 \u0432\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u00b7 %d \u0441\u0442\u0430\u0442\u044c\u0438 \u043c\u043e\u0433\u0443\u0442 \u0441\u043e\u0441\u043b\u0430\u0442\u044c\u0441\u044f","\u041d\u0435\u0442 \u0432\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u00b7 %d \u0441\u0442\u0430\u0442\u0435\u0439 \u043c\u043e\u0433\u0443\u0442 \u0441\u043e\u0441\u043b\u0430\u0442\u044c\u0441\u044f"],"No incoming links":["\u041d\u0435\u0442 \u0432\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u0441\u0441\u044b\u043b\u043e\u043a"],"Too few outgoing links \u00b7 need %s":["\u041c\u0430\u043b\u043e \u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u00b7 \u043d\u0443\u0436\u043d\u043e %s"],"More than one link per ~100 words hurts readability and looks like spam.":["\u0411\u043e\u043b\u044c\u0448\u0435 \u043e\u0434\u043d\u043e\u0439 \u0441\u0441\u044b\u043b\u043a\u0438 \u043d\u0430 ~100 \u0441\u043b\u043e