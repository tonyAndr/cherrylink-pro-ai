#. Plugin Name of the plugin
#: cherrylink_main.php
msgid "CherryLink – AI Internal Linking"
msgstr "CherryLink – AI Internal Linking"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: cherrylink_main.php
msgid "http://seocherry.ru/"
msgstr "http://seocherry.ru/"

#. Description of the plugin
#: cherrylink_main.php
msgid "A plugin for automatic internal linking based on semantic search (AI). It finds relevant posts and suggests anchor phrases using vector embeddings."
msgstr "Плагин для автоматической внутренней перелинковки на основе семантического поиска (AI). Находит релевантные статьи и предлагает анкорные фразы с помощью векторных эмбеддингов."

#. Author of the plugin
#: cherrylink_main.php
msgid "Anton SeoCherry.ru"
msgstr "Anton SeoCherry.ru"

#: cherrylink_main.php:23
msgid "Deactivate CherryLink Pro AI first. Two CherryLink plugins cannot run together."
msgstr "Deactivate CherryLink Pro AI first. Two CherryLink plugins cannot run together."

